# Installed by quota-pace "install.sh --cost" (rendered from systemd/cost-daily.service.in).
# Local only: reads transcripts under the Claude config dir, spends no tokens, sends nothing.
[Unit]
Description=Claude Code daily cost totals (cost --save; local, spends no tokens)

[Service]
Type=oneshot
ExecStart=@EXEC@ --save@PAYLAS@
@ENV@Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
