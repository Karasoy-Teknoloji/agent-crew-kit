# Installed by quota-pace "install.sh --last-window" (rendered from systemd/last-window.service.in).
# Runs ONE assignment in the foreground while the weekly quota has leftovers inside the last window: the script gives the work to a live
# interactive Claude session of the owner (a relay message) or starts the visible fallback session `last-window-<person>` in a detached
# tmux session, follows it and ends the run at the reset. The timer starts it again every 5 minutes, and systemd never starts a oneshot
# unit that is still running (one coordinator per user). The fallback runs on last-window's own tmux server (`tmux -L last-window`),
# started by this unit, so it lives in this unit's cgroup (KillMode=control-group) and ends with the run; the user's own tmux server
# (default socket) is never used or started here. Watch it from any terminal of the same user: `tmux -L last-window attach -t last-window-<person>`.
# @TETIK@ = `tetik --modes pencere,devam` as installed (--last-window = pencere, --resume-alarm = devam; burn mode runs when switched on).
[Unit]
Description=Claude Code last-window: last window, 5-hour resume alarm, burn mode (last-window trigger)

[Service]
Type=oneshot
ExecStart=@EXEC@ @TETIK@
@ENV@# Git auth without an ssh agent (none in a user service): the org's (GH_ORG) ssh remotes are read over https instead, so
# the push uses the gh credential helper from ~/.gitconfig, the same path as the daily cost job (cost-daily). Org-scoped on purpose.
Environment="GIT_TERMINAL_PROMPT=0"
@GITORG@Nice=10
TimeoutStartSec=infinity
KillMode=control-group
