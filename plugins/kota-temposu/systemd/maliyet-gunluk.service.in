# Installed by kota-temposu "kur.sh --maliyet" (rendered from systemd/maliyet-gunluk.service.in).
# Local only: reads transcripts under the Claude config dir, spends no tokens, sends nothing.
[Unit]
Description=Claude Code daily cost totals (maliyet --kaydet; local, spends no tokens)

[Service]
Type=oneshot
ExecStart=@EXEC@ --kaydet@PAYLAS@
@ENV@Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
