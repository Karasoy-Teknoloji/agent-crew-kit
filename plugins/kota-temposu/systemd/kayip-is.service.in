# Installed by kota-temposu kur.sh (rendered from systemd/kayip-is.service.in); runs tools/kayip_is.py from the claude-shared clone.
# Pushes own unpushed branches (never main/master/test/dev, never force, never someone else's commits); exit 1 = work still at risk.
[Unit]
Description=Lost-work check: push own unpushed git branches and remove lossless worktrees and local branches (kayip_is.py --push-unpushed --clean-lossless)

[Service]
Type=oneshot
ExecStart=@EXEC@
SuccessExitStatus=0 1
@ENV@Nice=19
IOSchedulingClass=idle
