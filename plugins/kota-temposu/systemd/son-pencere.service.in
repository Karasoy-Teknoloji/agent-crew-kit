# Installed by kota-temposu "kur.sh --son-pencere" (rendered from systemd/son-pencere.service.in).
# Runs ONE assignment in the foreground while the weekly quota has leftovers inside the last window: the script gives the work to a live
# interactive Claude session of the owner (a relay message) or starts the visible fallback session `son-pencere-<person>` in a detached
# tmux session, follows it and ends the run at the reset. The timer starts it again every 5 minutes, and systemd never starts a oneshot
# unit that is still running (one coordinator per user). The fallback runs on son-pencere's own tmux server (`tmux -L son-pencere`),
# started by this unit, so it lives in this unit's cgroup (KillMode=control-group) and ends with the run; the user's own tmux server
# (default socket) is never used or started here. Watch it from any terminal of the same user: `tmux -L son-pencere attach -t son-pencere-<person>`.
# @TETIK@ = `tetik --kipler pencere,devam` as installed (--son-pencere = pencere, --devam-alarmi = devam; burn mode runs when switched on).
[Unit]
Description=Claude Code son-pencere: last window, 5-hour resume alarm, burn mode (son-pencere tetik)

[Service]
Type=oneshot
ExecStart=@EXEC@ @TETIK@
@ENV@# Git auth without an ssh agent (none in a user service): the org's (GH_ORG) ssh remotes are read over https instead, so
# the push uses the gh credential helper from ~/.gitconfig, the same path as the daily cost job (maliyet-gunluk). Org-scoped on purpose.
Environment="GIT_TERMINAL_PROMPT=0"
@GITORG@Nice=10
TimeoutStartSec=infinity
KillMode=control-group
